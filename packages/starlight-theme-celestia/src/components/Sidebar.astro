---
/**
 * Multi-sidebar `Sidebar` override.
 *
 * Registered by the theme only when the `multiSidebar` option is set. It renders one switchable
 * sidebar per top-level group of the Starlight `sidebar` config, replacing
 * `@lorenzo_lewis/starlight-utils`, which is deprecated on npm.
 */
import config from "virtual:starlight-theme-celestia/user-config";

import MultiSidebarPanel from "./MultiSidebarPanel.astro";
import MultiSidebarSelect from "./MultiSidebarSelect.astro";
import MultiSidebarTabs from "./MultiSidebarTabs.astro";
import { getMultiSidebarGroups } from "./multi-sidebar";

const switcherStyle = config.multiSidebar?.switcherStyle ?? "horizontalList";
const groups = getMultiSidebarGroups(Astro.locals.starlightRoute.sidebar);

// Without a switcher there is nothing to switch to, so the other sidebars are never rendered.
const panels = switcherStyle === "hidden" ? groups.filter(({ isCurrent }) => isCurrent) : groups;
---

<celestia-multi-sidebar>
  {switcherStyle === "horizontalList" && <MultiSidebarTabs groups={groups} />}
  {switcherStyle === "dropdown" && <MultiSidebarSelect groups={groups} />}
  {
    panels.map((group) =>
      switcherStyle === "horizontalList" ? (
        <section id={group.panelId} role="tabpanel" aria-labelledby={group.tabId} hidden={!group.isCurrent}>
          <MultiSidebarPanel sidebar={group.entries} />
        </section>
      ) : (
        <section id={group.panelId} aria-label={group.label} hidden={!group.isCurrent}>
          <MultiSidebarPanel sidebar={group.entries} />
        </section>
      ),
    )
  }
</celestia-multi-sidebar>

<style>
  /*
   * The switcher and the sidebars have to sit in the sidebar flex column of `PageFrame`, so the
   * custom element adds no box of its own and the selected sidebar reproduces that column for the
   * entries it wraps. `hidden` still wins for the sidebars that are not selected, because the rule
   * below only applies to the selected one.
   */
  celestia-multi-sidebar {
    display: contents;
  }

  section:not([hidden]) {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: max-content;
  }
</style>

<script>
  class CelestiaMultiSidebar extends HTMLElement {
    #panels: HTMLElement[];
    #tabs: HTMLAnchorElement[];

    constructor() {
      super();

      this.#panels = [...this.querySelectorAll<HTMLElement>(":scope > section")];
      this.#tabs = [...this.querySelectorAll<HTMLAnchorElement>('[role="tab"]')];

      for (const [index, tab] of this.#tabs.entries()) {
        tab.addEventListener("click", (event) => {
          event.preventDefault();
          this.#select(index);
        });

        tab.addEventListener("keydown", (event) => {
          const nextIndex =
            event.key === "ArrowLeft"
              ? index - 1
              : event.key === "ArrowRight"
                ? index + 1
                : event.key === "Home"
                  ? 0
                  : event.key === "End"
                    ? this.#tabs.length - 1
                    : null;

          if (nextIndex === null || !this.#tabs[nextIndex]) return;

          event.preventDefault();
          this.#select(nextIndex);
          this.#tabs[nextIndex]?.focus();
        });
      }

      const select = this.querySelector("select");
      select?.addEventListener("change", () => {
        this.#select(this.#panels.findIndex((panel) => panel.id === select.value));
      });
    }

    #select(index: number) {
      if (index < 0) return;

      for (const [panelIndex, panel] of this.#panels.entries()) {
        panel.hidden = panelIndex !== index;
      }

      for (const [tabIndex, tab] of this.#tabs.entries()) {
        const isSelected = tabIndex === index;
        tab.setAttribute("aria-selected", isSelected ? "true" : "false");
        tab.setAttribute("tabindex", isSelected ? "0" : "-1");
      }
    }
  }

  if (!customElements.get("celestia-multi-sidebar")) {
    customElements.define("celestia-multi-sidebar", CelestiaMultiSidebar);
  }
</script>
