---
/**
 * `dropdown` switcher: a compact select listing every sidebar.
 */
import { Icon } from "@astrojs/starlight/components";

import type { MultiSidebarGroup } from "./multi-sidebar";

interface Props {
  groups: MultiSidebarGroup[];
}

const { groups } = Astro.props;
---

<label>
  <span class="sr-only">{Astro.locals.t("sidebarNav.accessibleLabel")}</span>
  <select autocomplete="off">
    {
      groups.map((group) => (
        <option value={group.panelId} selected={group.isCurrent}>
          {group.label}
        </option>
      ))
    }
  </select>
  <Icon name="down-caret" class="caret-icon" />
</label>

<style>
  label {
    --celestia-multi-sidebar-caret-size: 1rem;

    position: relative;
    display: flex;
    align-items: center;
    margin-block-end: 0.75rem;
    color: var(--sl-color-gray-2);
  }

  label:hover {
    color: var(--sl-color-white);
  }

  .caret-icon {
    position: absolute;
    top: 50%;
    inset-inline-end: 0.5rem;
    transform: translateY(-50%);
    pointer-events: none;
    font-size: var(--celestia-multi-sidebar-caret-size);
  }

  select {
    appearance: none;
    width: 100%;
    background-color: var(--sl-color-gray-6);
    border: 0;
    border-radius: 0.375rem;
    color: inherit;
    cursor: pointer;
    font-size: var(--sl-text-sm);
    padding-block: 0.35rem;
    padding-inline: 0.5rem calc(var(--celestia-multi-sidebar-caret-size) + 0.5rem);
    text-overflow: ellipsis;
  }

  option {
    background-color: var(--sl-color-black);
    color: var(--sl-color-gray-1);
  }
</style>
