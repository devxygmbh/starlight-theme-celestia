---
/**
 * Renders one sidebar of a multi-sidebar setup.
 *
 * Starlight's default `Sidebar` reads `Astro.locals.starlightRoute.sidebar` and takes no props, so
 * the entries of the sidebar being rendered are assigned onto the route data first.
 */
import Default from "@astrojs/starlight/components/Sidebar.astro";
import type { StarlightRouteData } from "@astrojs/starlight/route-data";

interface Props {
  sidebar: StarlightRouteData["sidebar"];
}

Astro.locals.starlightRoute.sidebar = Astro.props.sidebar;
---

<Default />
