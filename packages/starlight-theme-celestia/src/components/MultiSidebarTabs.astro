---
/**
 * `horizontalList` switcher: one tab per sidebar, rendered above the sidebar entries.
 */
import { Badge } from "@astrojs/starlight/components";

import type { MultiSidebarGroup } from "./multi-sidebar";

interface Props {
  groups: MultiSidebarGroup[];
}

const { groups } = Astro.props;
---

<div class="tablist-wrapper celestia-scroll-container not-content">
  <ul role="tablist">
    {
      groups.map((group) => (
        <li role="presentation">
          <a
            role="tab"
            id={group.tabId}
            href={`#${group.panelId}`}
            aria-selected={group.isCurrent ? "true" : "false"}
            aria-controls={group.panelId}
            tabindex={group.isCurrent ? 0 : -1}
          >
            <span>{group.label}</span>
            {group.badge && (
              <Badge variant={group.badge.variant} class={group.badge.class} text={group.badge.text} />
            )}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .tablist-wrapper {
    margin-block-end: 0.75rem;
    overflow-x: auto;
  }

  [role="tablist"] {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  [role="tab"] {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25em;
    /*
     * `ThemeProvider` already underlines every tab of the theme with `!important`, so this only
     * matters if that global styling is ever dropped.
     */
    box-shadow: inset 0 -1px 0 var(--sl-color-gray-5);
    padding: 0.25rem 0.5rem 0.4rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    line-height: 1.4;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
  }

  [role="tab"]:hover,
  [role="tab"]:focus-visible {
    color: var(--sl-color-white);
  }

  [role="tab"][aria-selected="true"] {
    box-shadow: inset 0 -2px 0 var(--sl-color-accent-high);
    color: var(--sl-color-white);
    font-weight: 600;
  }
</style>
