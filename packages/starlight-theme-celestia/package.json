{
  "name": "starlight-theme-celestia",
  "type": "module",
  "version": "0.3.4",
  "description": "A clean, modern theme for Astro Starlight",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devxygmbh/starlight-theme-celestia.git"
  },
  "sideEffects": false,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*.css": "./lib/*.css",
    "./components": "./src/components/index.ts",
    "./components/*.astro": "./src/components/*.astro"
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "bun run build:tailwindcss",
    "build:tailwindcss": "tailwindcss -i ./lib/tailwind.build.css -o ./lib/tailwind.gen.css",
    "test": "bun test"
  },
  "dependencies": {
    "@aria-ui/core": "^0.2.1",
    "@aria-ui/utils": "^0.1.8",
    "@astrojs/markdown-remark": "^7.3.10",
    "@fontsource/inter": "^5.3.0",
    "@pagefind/default-ui": "^1.6.0",
    "@shikijs/transformers": "^4.6.0",
    "@shikijs/twoslash": "^4.6.0",
    "@shikijs/types": "^4.6.0",
    "@types/hast": "^3.0.5",
    "hast-util-is-element": "^3.0.0",
    "rehype": "^13.0.2",
    "remark-custom-header-id": "^1.0.0",
    "shiki-twoslash-renderer": "^0.3.5",
    "starlight-versions": "^0.10.2"
  },
  "peerDependencies": {
    "@astrojs/starlight": "*",
    "typescript": "^5.5.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "@astrojs/starlight": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.43.1",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.11",
    "astro": "^7.4.13",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  }
}
